{
  "manifest_version": 3,
  "name": "GoonFap — FapHero DualShock (18+)",
  "short_name": "GoonFap",
  "version": "1.5.0",
  "description": "18+ : fait vibrer ta manette PS4 au rythme des vidéos FapHero sur n'importe quel site et affiche des messages coquins par-dessus.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "scripting",
    "storage",
    "activeTab",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoonFap",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "split",
  "web_accessible_resources": [
    {
      "resources": [
        "gifview.html",
        "gifview.js",
        "gifs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}